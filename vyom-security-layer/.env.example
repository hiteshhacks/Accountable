# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VYOM_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
VYOM_DATABASE_URL=sqlite:///./vyom_security.db
VYOM_JWT_ISSUER=vyom-security-layer
VYOM_JWT_AUDIENCE=vyom-api
VYOM_ACCESS_TOKEN_MINUTES=15
VYOM_MAX_REQUEST_BYTES=2000000
VYOM_LOGIN_RATE_LIMIT_ATTEMPTS=5
VYOM_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
VYOM_DEBUG=false
VYOM_ALLOWED_ORIGINS=
